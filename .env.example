# Copy file ini menjadi .env.local lalu isi semua nilai
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Login with X (https://developer.x.com -> buat App -> OAuth 2.0)
X_CLIENT_ID=isi-client-id-dari-x-developer
X_CLIENT_SECRET=isi-client-secret-dari-x-developer

# URL publik aplikasi (tanpa garis miring di akhir)
# Lokal: http://localhost:3000
APP_URL=http://localhost:3000
